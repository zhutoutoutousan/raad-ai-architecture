# GPU Configuration
CUDA_VISIBLE_DEVICES=0
NVIDIA_VISIBLE_DEVICES=all
NVIDIA_DRIVER_CAPABILITIES=compute,utility

# Project Configuration
PROJECT_NAME=architectural_style_classification
PROJECT_VERSION=1.0.0
ENVIRONMENT=development

# Data Configuration
DATA_DIR=/workspace/data
MODELS_DIR=/workspace/models
LOGS_DIR=/workspace/logs
CONFIGS_DIR=/workspace/configs

# Kaggle Configuration
KAGGLE_USERNAME=wwymak
KAGGLE_DATASET=architecture-dataset

# Weights & Biases
WANDB_API_KEY=your_wandb_api_key_here
WANDB_PROJECT=architectural-style-classification
WANDB_ENTITY=your_username

# MLflow Configuration
MLFLOW_TRACKING_URI=http://localhost:5000
MLFLOW_EXPERIMENT_NAME=architectural_style_classification

# Database Configuration
POSTGRES_DB=arch_style_db
POSTGRES_USER=arch_user
POSTGRES_PASSWORD=arch_password_2025
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Redis Configuration
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
GRADIO_PORT=8001

# Model Configuration
MODEL_BACKBONE=efficientnet-b4
BATCH_SIZE=32
LEARNING_RATE=0.001
NUM_EPOCHS=100
NUM_CLASSES=25

# Training Configuration
TRAIN_SPLIT=0.8
VAL_SPLIT=0.1
TEST_SPLIT=0.1
RANDOM_SEED=42

# GPU Configuration
GPU_MEMORY_FRACTION=0.9
MIXED_PRECISION=true
GRADIENT_ACCUMULATION_STEPS=1

# Logging Configuration
LOG_LEVEL=INFO
LOG_FORMAT=json

# Security
JWT_SECRET_KEY=your_jwt_secret_key_here
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Monitoring
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
TENSORBOARD_PORT=6006
