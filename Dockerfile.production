# Production Dockerfile for Architectural Style Classification
FROM python:3.10-slim

# Set environment variables
ENV PYTHONUNBUFFERED=1
ENV PYTHONPATH=/app
ENV CUDA_VISIBLE_DEVICES=0

# Install system dependencies
RUN apt-get update && apt-get install -y \
    git \
    wget \
    curl \
    build-essential \
    && rm -rf /var/lib/apt/lists/*

# Set working directory
WORKDIR /app

# Copy requirements first for better caching
COPY requirements.txt .

# Install Python dependencies with specific versions for production
RUN pip install --no-cache-dir --upgrade pip && \
    pip install --no-cache-dir \
    torch==2.0.1+cu118 \
    torchvision==0.15.2+cu118 \
    torchaudio==2.0.2+cu118 \
    --index-url https://download.pytorch.org/whl/cu118 && \
    pip install --no-cache-dir \
    timm==0.9.2 \
    transformers==4.30.2 \
    pytorch-lightning==2.0.6 \
    tensorboard==2.13.0 \
    wandb==0.15.8 \
    numpy>=1.24.0 \
    pandas==2.0.3 \
    scikit-learn==1.3.0 \
    matplotlib==3.7.2 \
    seaborn>=0.12.2 \
    pillow==10.0.0 \
    opencv-python==4.8.0.76 \
    kagglehub==0.3.13 \
    optuna==3.2.0 \
    ray[tune]==2.6.3 \
    hydra-core==1.3.2 \
    omegaconf==2.3.0

# Copy source code
COPY src/ ./src/
COPY scripts/ ./scripts/
COPY configs/ ./configs/

# Copy experiment scripts
COPY run_experiment.py .
COPY scale_up_experiments.py .
COPY hyperparameter_optimization.py .
COPY setup_real_data.py .

# Create necessary directories
RUN mkdir -p /app/data /app/models /app/logs /app/results /app/paper

# Set permissions
RUN chmod +x scripts/*.sh

# Expose ports for TensorBoard and other services
EXPOSE 6006 8080

# Default command
CMD ["tail", "-f", "/dev/null"]
